# Copy to .env and fill in (admin API / agent process)

# Preferred: Groq (OpenAI-compatible, very fast)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Current production default — fast chat model on Groq developer tier:
GROQ_MODEL=openai/gpt-oss-20b
# Stronger (slower/costlier) alternative:
# GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Fallbacks (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Optional OCR for image warehouse docs (deps in bis-mitra-admin/api)
# OCR_ENABLED=1
# OCR_LANG=eng

# --- Speech-to-text (portal mic → POST /api/transcribe) ---
# Primary: Groq Whisper (free tier ~2000 req/day) — same key as chat if you use Groq
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_PRIMARY=groq
# STT_FALLBACK=sarvam,bhashini

# Optional: Sarvam Saaras (Hinglish / codemix) — set STT_HIGH_ACCURACY_PROVIDER=sarvam
# SARVAM_API_KEY=
# STT_SARVAM_MODEL=saaras:v3
# STT_SARVAM_MODE=codemix

# Optional: Bhashini ULCA pipeline (free fallback for Hindi)
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=
# BHASHINI_ASR_SERVICE_ID=

# WhatsApp alerts (application submitted / status changed)
# Target number is +91 9556828397 unless overridden
WHATSAPP_TO=+919556828397
# Twilio WhatsApp (sandbox or production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta Cloud API
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CallMeBot (get a key by messaging the bot)
# WHATSAPP_CALLMEBOT_APIKEY=

# BIS clone pages for "Open on BIS" / source provenance
BIS_WEB=http://localhost:3001
CLONE_API=http://localhost:4000
# SOURCE_MIN_SCORE=0.5
# SOURCE_MAX=5
